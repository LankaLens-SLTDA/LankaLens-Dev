# LankaLens Workspace Root Environment Template
# Copy this file to backend/.env and frontend/.env.local for local development.

# -----------------------------------------------------------------------------
# FastAPI Backend Configuration (backend/.env)
# -----------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Next.js Frontend Configuration (frontend/.env.local)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# Backend Supabase Credentials (backend/.env)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

